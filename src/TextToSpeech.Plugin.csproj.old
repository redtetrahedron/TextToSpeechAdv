<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-android35.0</TargetFramework>
		<AssemblyName>Plugin.TextToSpeech</AssemblyName>
		<RootNamespace>Plugin.TextToSpeech</RootNamespace>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
		<LangVersion>latest</LangVersion>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
		<Version>1.0.0.0</Version>
		<Authors>James Montemagno, Sam DiPiazza</Authors>
		<PackageId>redtetrahedron.Plugins.TextToSpeech</PackageId>
		<PackOnBuild>true</PackOnBuild>
		<PackageIconUrl>http://refractored.com/images/tts_icon_large.png</PackageIconUrl>
		<PackageLicenseUrl>https://github.com/jamesmontemagno/TextToSpeechPlugin/blob/master/LICENSE</PackageLicenseUrl>
		<Owners>JamesMontemagno</Owners>
		<Summary>Cross platform Text-to-Speech for MAUI.</Summary>
		<PackageTags>maui, android, ios, windows phone, windows store, winrt, universal apps, mac, text to speech, tts, texttospeech</PackageTags>
		<Title>Text to Speech Plugin for MAUI</Title>
		<Description>
			MAUI plugin to perform text to speech functionality.
			Adjustable pitch, speak rate, locale, and more.
		</Description>
		<Copyright>Copyright 2018, 2025</Copyright>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>default</LangVersion>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<GenerateDocumentationFile Condition=" '$(Configuration)' == 'Release' ">true</GenerateDocumentationFile>
		<DefineConstants>$(DefineConstants);</DefineConstants>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)'=='Debug' ">
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)'=='Release' ">
		<DebugType>pdbonly</DebugType>
	</PropertyGroup>
	
